# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy to .env and fill in. .env is gitignored and is NOT part of the submission.

# ----- AUTHENTICATION -----
# In the Vocareum workspace ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL are already
# set in the shell environment; leave them out of .env there.
#
# For local development with the Udacity-provided credentials:
# ANTHROPIC_API_KEY=voc-your-key-here
# ANTHROPIC_BASE_URL=https://claude.vocareum.com
#
# For local development with a personal Anthropic key (do NOT set a base URL):
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ----- MODEL CONFIGURATION (REQUIRED) -----
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Available models:
#   - claude-sonnet-4-5-20250929 (recommended)
#   - claude-haiku-4-5-20251001 (faster, cheaper)
# For AWS Bedrock use e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ----- PROJECT ROOT (REQUIRED) -----
# Absolute path to this project/starter directory.
# MUST contain the .claude/skills/ directory, or the Skill tool cannot resolve skills.
PROJECT_ROOT=/absolute/path/to/project/starter

# ----- AGENT SDK CONFIG ISOLATION (required on machines with Claude Code installed) -----
# The SDK spawns the bundled Claude Code CLI. If that CLI finds an interactive
# Claude Code login it sends an OAuth Bearer token instead of ANTHROPIC_API_KEY,
# which a proxied endpoint rejects with: 400 "This key was not found".
# Point it at an isolated config dir containing a .claude.json of the form:
#   { "hasCompletedOnboarding": true,
#     "customApiKeyResponses": { "approved": ["<last 20 chars of your API key>"], "rejected": [] } }
# Without the approval entry the CLI blocks forever on a hidden consent prompt.
# CLAUDE_CONFIG_DIR=/absolute/path/to/isolated-claude-config

# ----- GITHUB TOKEN (RECOMMENDED) -----
# Higher rate limits and private repository access.
# Generate at https://github.com/settings/tokens with scopes: repo, read:org
# (If you use the GitHub CLI: gh auth token)
# GITHUB_TOKEN=ghp_your-token-here

# ----- LOGGING (OPTIONAL) -----
# Options: error, warn, info, debug
LOG_LEVEL=info
